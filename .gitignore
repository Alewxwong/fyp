@"
# RadioMapSeer dataset
RadioMapSeer/

# Model outputs
parameter/outputs/
parameter/outputs_gradient/
flops/outputs/
flops/outputs_flops/
outputs/
outputs_flops/

# Checkpoints
*.pt
*.pth
*.ckpt

# TensorBoard and experiment logs
**/tb/
**/runs/
**/slurm_logs/
slurm-*.out
*.log

# Generated manifests
parameter/data/manifests/*.csv
flops/data/manifests/*.csv

# Keep fixed split files
!parameter/data/splits/
!parameter/data/splits/*.txt
!flops/data/splits/
!flops/data/splits/*.txt

# Generated FLOP search output
flops/flop_search_results.csv
flops/flops_*.txt

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Environments and secrets
.env
.env.*
.venv/
venv/
env/

# Editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
"@ | Set-Content -Encoding UTF8 .gitignore
